# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Keep development-only files out of the dist archive Composer downloads, so a
# consumer's vendor directory holds the package and nothing else.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/art                export-ignore
/tests              export-ignore
/workbench          export-ignore
/phpunit.xml        export-ignore
/rector.php         export-ignore
/pint.json          export-ignore
/testbench.yaml     export-ignore
/CHANGELOG.md       export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md    export-ignore
/SECURITY.md        export-ignore

# Normalise line endings, and treat these as text regardless of content
# sniffing so diffs stay readable.
*.php               text eol=lf
*.blade.php         text eol=lf
*.json              text eol=lf
*.md                text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.xml               text eol=lf

# Never touch the demo fixtures.
*.png               binary
*.jpg               binary
*.gif               binary
*.webp              binary
*.pdf               binary
*.mp4               binary
*.wav               binary
